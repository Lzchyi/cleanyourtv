<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF324C70" />
            <corners android:radius="@dimen/premium_corner_radius" />
            <stroke android:width="2dp" android:color="@color/premium_focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF284569" />
            <corners android:radius="@dimen/premium_corner_radius" />
            <stroke android:width="1dp" android:color="#FF6B94C4" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/premium_surface" />
            <corners android:radius="@dimen/premium_corner_radius" />
        </shape>
    </item>
</selector>
